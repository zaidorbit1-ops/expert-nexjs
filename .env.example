# Supabase project settings. The anon key is safe to expose through this NEXT_PUBLIC value.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=https://expertassignmentwriters.co.uk

# Server-only Supabase key. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required for contact/order form submissions. Keep the integration secret server-side.
CRM_WEBSITE_ID=
CRM_INTEGRATION_SECRET=
CRM_ENDPOINT=https://office.digifyitsolution.com/api/crm/integrations/leads
